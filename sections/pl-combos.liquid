{{ 'pl-base.css' | asset_url | stylesheet_tag }}
{{ 'pl-combos.css' | asset_url | stylesheet_tag }}
{% render 'pl-fonts' %}

{%- comment -%}
  Each combo is a real product (create it with Shopify Bundles or as a normal product) in the chosen collection:
    price / compare-at / URL / title   native product fields
    custom.bundle_items                list of products      -> the "A + B + C" tray and the "Includes" line
    custom.badge                       single line text      -> the dark flag ("Most popular")
    custom.save_label                  single line text      -> overrides the "You save ₹X" chip
    custom.highlight                   true/false            -> gold border + primary button
    custom.summary                     multi-line text       -> sentence after "Includes: ..."
  Component products supply custom.short_name (name in the "Includes" line) and custom.benefit (label under each bottle).
{%- endcomment -%}

<section
  class="pl-sec"
  id="{{ section.settings.anchor | default: 'combos' | handleize }}"
  data-pl-scene="{{ section.settings.scene }}"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="pl-d2">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="pl-rule" aria-hidden="true"><i></i>{% render 'pl-icon', name: 'leaf' %}<i></i></div>
      {%- if section.settings.lede != blank -%}<p class="pl-lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      <div class="pl-comborail pl-rv" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign items = product.metafields.custom.bundle_items.value
            assign badge = product.metafields.custom.badge.value
            assign save_label = product.metafields.custom.save_label.value
            assign highlight = product.metafields.custom.highlight.value
            assign summary = product.metafields.custom.summary.value
            assign second_last = items.size | minus: 1
            assign saved = 0
            if variant.compare_at_price > variant.price
              assign saved = variant.compare_at_price | minus: variant.price
            endif
          -%}
          <article class="pl-glass pl-combo{% if highlight %} pl-combo--highlight{% endif %}">
            <div class="pl-combo__tray">
              {%- if save_label != blank -%}
                <span class="pl-combo__save">{{ save_label }}</span>
              {%- elsif saved > 0 -%}
                <span class="pl-combo__save">You save {{ saved | money_without_trailing_zeros }}</span>
              {%- endif -%}
              {%- if badge != blank -%}<span class="pl-combo__flag">{{ badge }}</span>{%- endif -%}

              <div class="pl-stack">
                {%- for item in items limit: section.settings.max_thumbs -%}
                  {%- unless forloop.first -%}<span class="pl-stack__plus" aria-hidden="true">+</span>{%- endunless -%}
                  <span class="pl-stack__item">
                    {%- if item.featured_image -%}
                      {% render 'pl-image',
                        image: item.featured_image,
                        alt: item.title,
                        widths: '80,120,180',
                        sizes: '48px',
                        class: 'pl-stack__img' %}
                    {%- else -%}
                      <span class="pl-tile pl-stack__tile">{% render 'pl-icon', name: 'leaf' %}</span>
                    {%- endif -%}
                    <span class="pl-stack__label">{{ item.metafields.custom.benefit.value | default: item.metafields.custom.short_name.value | default: item.title }}</span>
                  </span>
                {%- else -%}
                  <span class="pl-stack__item">
                    {%- if product.featured_image -%}
                      {% render 'pl-image', image: product.featured_image, alt: product.title, widths: '80,120,180', sizes: '48px', class: 'pl-stack__img' %}
                    {%- endif -%}
                  </span>
                {%- endfor -%}
              </div>
            </div>

            <div class="pl-combo__body">
              <h3 class="pl-combo__title">{{ product.title }}</h3>
              {%- if items.size > 0 -%}
                <div class="pl-combo__cnt">{{ items.size }} products</div>
                <p class="pl-combo__inc">
                  Includes:
                  {% for item in items -%}
                    {{- item.metafields.custom.short_name.value | default: item.title -}}
                    {%- unless forloop.last -%}{%- if forloop.index == second_last %} &amp; {% else %}, {% endif -%}{%- endunless -%}
                  {%- endfor %}.
                  {%- if summary != blank %} {{ summary }}{% endif -%}
                </p>
              {%- else -%}
                <p class="pl-combo__inc">{{ summary | default: product.description | strip_html | truncate: 140 }}</p>
              {%- endif -%}

              <div class="pl-combo__prow">
                {% render 'pl-price', price: variant.price, compare_at: variant.compare_at_price, off: 'amount' %}
              </div>
              {%- if section.settings.fine_print != blank -%}
                <div class="pl-combo__fine">{{ section.settings.fine_print }}</div>
              {%- endif -%}
              <a class="pl-btn pl-btn--block {% if highlight %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}" href="{{ product.url }}">
                {{ section.settings.cta_label }} {% render 'pl-icon', name: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.swipe_text != blank -%}
        <div class="pl-swipecue" aria-hidden="true">{% render 'pl-icon', name: 'arrow' %}{{ section.settings.swipe_text }}</div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="pl-railnote">{{ section.settings.note }}</p>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="pl-empty-note">Choose a collection of bundle products in the section settings.</p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'pl-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "div",
  "class": "pl",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "collection", "id": "collection", "label": "Collection of bundle products" },
    { "type": "range", "id": "limit", "label": "Combos to show", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "max_thumbs", "label": "Bottles shown in each card", "min": 2, "max": 5, "step": 1, "default": 3, "info": "The \"Includes\" line and product count always list every item." },
    { "type": "header", "content": "Card text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop bundle" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
    { "type": "text", "id": "swipe_text", "label": "Swipe hint", "default": "Swipe for more combos" },
    { "type": "textarea", "id": "note", "label": "Note under the rail", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." },
    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "combos" },
    {
      "type": "select", "id": "scene", "label": "Background scene", "default": "3",
      "options": [
        { "value": "1", "label": "1 – Surface" }, { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }, { "value": "4", "label": "4 – Deep" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane combos" }]
}
{% endschema %}
