{{ 'pl-base.css' | asset_url | stylesheet_tag }}
{{ 'pl-hero.css' | asset_url | stylesheet_tag }}
{% render 'pl-fonts' %}

{%- liquid
  assign badges = section.blocks | where: 'type', 'badge'
  assign slides = section.blocks | where: 'type', 'slide'
  assign heading_lines = section.settings.heading | newline_to_br | split: '<br />'
-%}

<section
  class="pl-hero full-width"
  id="{{ section.settings.anchor | default: 'top' | handleize }}"
  data-pl-hero
  data-pl-scene="{{ section.settings.scene }}"
  style="--pl-header-offset: {{ section.settings.header_offset }}px;"
>
  <div class="pl-hero__grid">
    <div class="pl-hero__copy">
      <h1 class="pl-d1">
        {%- for line in heading_lines -%}
          {%- assign line = line | strip -%}
          {%- if forloop.last and section.settings.accent_last_line -%}
            <span class="pl-accent">{{ line }}</span>
          {%- else -%}
            {{ line }}{% unless forloop.last %}<br>{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      </h1>
      <div class="pl-rule pl-hero__rule pl-rv pl-rv-d1" aria-hidden="true"><i></i>{% render 'pl-icon', name: 'leaf' %}<i></i></div>

      {%- if section.settings.lede != blank -%}
        <p class="pl-lede pl-rv pl-rv-d2">{{ section.settings.lede }}</p>
      {%- endif -%}

      <div class="pl-hero__cta pl-rv pl-rv-d3">
        {%- if section.settings.primary_label != blank -%}
          <a class="pl-btn pl-btn--primary" href="{{ section.settings.primary_link | default: '#shop' }}">
            {{ section.settings.primary_label }} {% render 'pl-icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="pl-btn pl-btn--ghost" href="{{ section.settings.secondary_link | default: '#how' }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if badges.size > 0 -%}
      <ul class="pl-badges pl-glass-2" aria-label="{{ section.settings.badges_label | escape }}">
        {%- for block in badges -%}
          <li class="pl-badge" {{ block.shopify_attributes }}>
            <span class="pl-badge__icon">{% render 'pl-icon', name: block.settings.icon %}</span>
            <span class="pl-badge__label pl-badge__label--long">{{ block.settings.label | newline_to_br }}</span>
            <span class="pl-badge__label pl-badge__label--short">{{ block.settings.label_short | default: block.settings.label | strip_newlines }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if slides.size > 0 -%}
      <div class="pl-hero__prod" data-pl-prod>
        <div
          class="pl-hstage"
          data-pl-stage
          data-autoplay="{{ section.settings.autoplay }}"
          data-interval="{{ section.settings.interval }}"
          role="group"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.stage_label | escape }}"
        >
          {%- for block in slides -%}
            {%- liquid
              assign s = block.settings
              assign qty = s.tier_quantity
              assign count = 0
              assign slide_first = forloop.first
              if s.product_1 != blank
                assign count = count | plus: 1
              endif
              if s.product_2 != blank
                assign count = count | plus: 1
              endif
              if s.product_3 != blank
                assign count = count | plus: 1
              endif
              assign price = 0
              assign mrp = 0
              if qty <= 1
                assign v = s.product_1.selected_or_first_available_variant
                assign price = v.price
                assign mrp = v.compare_at_price
              else
                for t in shop.metaobjects.pl_bundle_tier.values
                  if t.quantity.value == qty
                    capture tier_data
                      render 'pl-tier-data', tier: t
                    endcapture
                    assign td = tier_data | strip | split: '|'
                    assign price = td[0] | plus: 0
                    assign mrp = td[1] | plus: 0
                    break
                  endif
                endfor
              endif
            -%}
            <div
              class="pl-hslide pl-hs{{ count }}{% if forloop.first %} is-on{% endif %}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} of {{ forloop.length }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- for slot in (1..3) -%}
                {%- liquid
                  case slot
                    when 1
                      assign p = s.product_1
                      assign cls = 'a'
                    when 2
                      assign p = s.product_2
                      assign cls = 'b'
                    when 3
                      assign p = s.product_3
                      assign cls = 'c'
                  endcase
                  assign img = p.images[1] | default: p.featured_image
                  assign hp_class = 'pl-hp pl-hp--' | append: cls
                  assign hp_loading = 'lazy'
                  assign hp_priority = 'auto'
                  if slide_first and slot == 1
                    assign hp_loading = 'eager'
                    assign hp_priority = 'high'
                  endif
                -%}
                {%- if p != blank and img != blank -%}
                  {% render 'pl-image',
                    image: img,
                    alt: p.title,
                    widths: '240,360,480',
                    sizes: '(min-width: 900px) 240px, 40vw',
                    class: hp_class,
                    loading: hp_loading,
                    fetchpriority: hp_priority %}
                {%- endif -%}
              {%- endfor -%}

              {%- if price > 0 -%}
                <div class="pl-glass-2 pl-ptag">
                  <span class="pl-ptag__lbl">{{ s.label }}</span>
                  {% render 'pl-price', price: price, compare_at: mrp %}
                  {%- if mrp > price -%}
                    <span class="pl-ptag__cut">
                      {%- if qty <= 1 -%}
                        {{ mrp | minus: price | times: 100.0 | divided_by: mrp | round }}% off
                      {%- else -%}
                        Save {{ mrp | minus: price | money_without_trailing_zeros }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if slides.size > 1 -%}
          <div class="pl-hdots">
            {%- for block in slides -%}
              <button type="button" data-pl-dot class="{% if forloop.first %}is-on{% endif %}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show slide {{ forloop.index }}: {{ block.settings.label | escape }}"></button>
            {%- endfor -%}
          </div>
          {%- if section.settings.autoplay -%}
            <button type="button" class="pl-hero__pause" data-pl-pause aria-pressed="false">Pause slideshow</button>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'pl-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'pl-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "div",
  "class": "pl",
  "max_blocks": 9,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading (one line per row)", "default": "Clean\nThat\nLasts" },
    { "type": "checkbox", "id": "accent_last_line", "label": "Colour the last line", "default": true },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop now" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "How it works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Product stage" },
    { "type": "checkbox", "id": "autoplay", "label": "Rotate slides automatically", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "text", "id": "stage_label", "label": "Accessible name for the stage", "default": "Purelane bundle prices" },
    { "type": "text", "id": "badges_label", "label": "Accessible name for the badges", "default": "Product promises" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range", "id": "header_offset", "label": "Header height to subtract from the full-height hero (px)",
      "min": 0, "max": 200, "step": 4, "default": 0,
      "info": "The prototype's nav floated over the hero. Set this to your header's height if the hero should fit one screen below it."
    },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "top" },
    {
      "type": "select", "id": "scene", "label": "Background scene", "default": "1",
      "options": [
        { "value": "1", "label": "1 – Surface" }, { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }, { "value": "4", "label": "4 – Deep" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "ban", "label": "No symbol" }
          ]
        },
        { "type": "textarea", "id": "label", "label": "Label (desktop, line breaks kept)", "default": "Plant\npowered" },
        { "type": "text", "id": "label_short", "label": "Label (mobile)", "default": "Plant powered" }
      ]
    },
    {
      "type": "slide",
      "name": "Product slide",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Price flag label", "default": "Single bottle" },
        {
          "type": "range", "id": "tier_quantity", "label": "Bundle tier quantity", "min": 1, "max": 5, "step": 1, "default": 1,
          "info": "1 uses the first product's own price. 2+ reads the price from the Bundle tier entry with that quantity."
        },
        { "type": "product", "id": "product_1", "label": "Product A", "info": "Uses the product's 2nd image (the bottle shot) if it has one." },
        { "type": "product", "id": "product_2", "label": "Product B" },
        { "type": "product", "id": "product_3", "label": "Product C" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "Plant\npowered", "label_short": "Plant powered" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "Safe for\nkids & pets", "label_short": "Kids & pet safe" } },
        { "type": "badge", "settings": { "icon": "ban", "label": "Zero harsh\nchemicals", "label_short": "Zero harsh chem" } },
        { "type": "slide", "settings": { "label": "Single bottle", "tier_quantity": 1 } },
        { "type": "slide", "settings": { "label": "Any 2 products", "tier_quantity": 2 } },
        { "type": "slide", "settings": { "label": "Any 3 products", "tier_quantity": 3 } }
      ]
    }
  ]
}
{% endschema %}
