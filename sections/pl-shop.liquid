{{ 'pl-base.css' | asset_url | stylesheet_tag }}
{{ 'pl-shop.css' | asset_url | stylesheet_tag }}
{% render 'pl-fonts' %}

{%- liquid
  assign shop_collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section
  class="pl-sec pl-shop full-width"
  id="{{ section.settings.anchor | default: 'shop' | handleize }}"
  data-pl-scene="{{ section.settings.scene }}"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="pl-d2">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="pl-rule" aria-hidden="true"><i></i>{% render 'pl-icon', name: 'leaf' %}<i></i></div>
    </div>

    {%- if shop_collection != blank and shop_collection.products_count > 0 -%}
      <div class="pl-shelf">
        {%- for product in shop_collection.products limit: limit -%}
          {% render 'pl-product-card', product: product, index: forloop.index0, eager: forloop.first %}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="pl-empty-note">Choose a collection with products in the section settings.</p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'pl-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'pl-atc.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane shop grid",
  "tag": "div",
  "class": "pl",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 2, "default": 8 },
    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "shop", "info": "Used by #links such as the hero button." },
    {
      "type": "select", "id": "scene", "label": "Background scene", "default": "3",
      "info": "Which depth of the page backdrop shows behind this section.",
      "options": [
        { "value": "1", "label": "1 – Surface" }, { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }, { "value": "4", "label": "4 – Deep" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane shop grid" }]
}
{% endschema %}
