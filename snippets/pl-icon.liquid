{%- comment -%}
  Inline icons used across the Purelane sections.
  Accepts: name (leaf | shield | ban | check | arrow), stroke_width (optional)
{%- endcomment -%}
{%- liquid
  case name
    when 'arrow'
      assign sw = stroke_width | default: 2.2
    when 'check'
      assign sw = stroke_width | default: 2.4
    else
      assign sw = stroke_width | default: 1.6
  endcase
-%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'leaf' -%}
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/>
    {%- when 'ban' -%}
      <circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/>
    {%- when 'check' -%}
      <path d="m5 13 4 4L19 7"/>
    {%- when 'arrow' -%}
      <path d="M5 12h13m-5-6 6 6-6 6"/>
  {%- endcase -%}
</svg>
